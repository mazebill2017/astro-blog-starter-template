{
  "name": "pos-supermarket-api",
  "description": "POS Kasir Supermarket dengan Cloudflare Workers + D1 Database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "echo 'No build step needed for Workers'",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,js}\"",
    "db:migrate:local": "wrangler d1 migrations apply POS_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply POS_DB --remote",
    "db:seed": "node scripts/seed.js"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
